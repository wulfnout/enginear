# Server-side secrets. Set them with:  supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically.)
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-haiku-5-5
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx   # second destination for connected-account events
STRIPE_CONNECT_RETURN_URL=enginear://payouts-done
CHECKR_API_KEY=your-checkr-key
CHECKR_PACKAGE=tasker_standard
CHECKR_WEBHOOK_SECRET=your-checkr-key
EXPO_ACCESS_TOKEN=optional-expo-push-access-token
SEND_PUSH_SECRET=make-up-a-long-random-string
