# Copy to .env and fill in. EXPO_PUBLIC_ values are bundled into the app (safe, public keys only).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
EXPO_PUBLIC_SUPPORT_EMAIL=enginearsupport@gmail.com

# Used only at build time
GOOGLE_MAPS_ANDROID_API_KEY=your-google-maps-android-key
EAS_PROJECT_ID=your-eas-project-id
